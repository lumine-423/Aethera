          {
            "id": "kl-re-bts-card-07",
            "scriptName": "昆仑-片场拍摄花絮美化卡片(显示, 0~1层)",
            "disabled": false,
            "runOnEdit": true,
            "findRegex": "/<BTS>([\\s\\S]*?)<\\/BTS>/g",
            "trimStrings": [],
            "replaceString": "```\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>片场花絮特辑 - 默认收起版</title>\n    <style>\n        :root {\n            --bg-main: #141418;\n            --bg-stage: #1b1b22;\n            --border-line: rgba(255, 255, 255, 0.08);\n            --gold-accent: #f59e0b;\n            --gold-soft: rgba(245, 158, 11, 0.14);\n            --text-body: #e5e7eb;\n            --text-quote: #fde68a;\n            --text-muted: #9ca3af;\n            --rec-red: #ef4444;\n        }\n\n        body {\n            margin: 0;\n            padding: 10px;\n            background: transparent;\n            font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n            color: var(--text-body);\n        }\n\n        details.bts-theater {\n            width: 100%;\n            max-width: 760px;\n            margin: 0 auto;\n            background: var(--bg-main);\n            border: 1px solid var(--border-line);\n            border-radius: 14px;\n            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.55);\n            overflow: hidden;\n            transition: border-color 0.2s;\n        }\n\n        details.bts-theater:hover {\n            border-color: rgba(245, 158, 11, 0.28);\n        }\n\n        /* 顶部经典场记板黑黄斜纹 */\n        .clapper-top {\n            height: 6px;\n            width: 100%;\n            background: repeating-linear-gradient(\n                -45deg,\n                #18181b,\n                #18181b 12px,\n                var(--gold-accent) 12px,\n                var(--gold-accent) 24px\n            );\n            opacity: 0.9;\n        }\n\n        /* 可点击的场记板头部 */\n        summary.bts-header {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);\n            cursor: pointer;\n            user-select: none;\n            border-bottom: 1px solid rgba(255, 255, 255, 0.04);\n        }\n\n        summary.bts-header::-webkit-details-marker {\n            display: none;\n        }\n\n        .header-bar {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 14px 20px;\n        }\n\n        .header-left {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        .slate-icon {\n            font-size: 18px;\n            line-height: 1;\n        }\n\n        .header-title {\n            font-size: 15px;\n            font-weight: 700;\n            color: #fff;\n            letter-spacing: 0.5px;\n        }\n\n        .header-sub {\n            font-size: 11px;\n            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n            color: var(--gold-accent);\n            background: var(--gold-soft);\n            padding: 2px 8px;\n            border-radius: 4px;\n            border: 1px solid rgba(245, 158, 11, 0.3);\n        }\n\n        .header-right {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n        }\n\n        /* REC 呼吸灯状态 */\n        .rec-indicator {\n            display: inline-flex;\n            align-items: center;\n            gap: 6px;\n            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n            font-size: 11px;\n            font-weight: 700;\n            color: #fca5a5;\n            background: rgba(239, 68, 68, 0.12);\n            border: 1px solid rgba(239, 68, 68, 0.25);\n            padding: 3px 9px;\n            border-radius: 20px;\n        }\n\n        .rec-dot {\n            width: 6px;\n            height: 6px;\n            border-radius: 50%;\n            background: var(--rec-red);\n            box-shadow: 0 0 6px var(--rec-red);\n            animation: blink 2s infinite ease-in-out;\n        }\n\n        @keyframes blink {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.25; }\n        }\n\n        .toggle-btn {\n            font-size: 12px;\n            color: var(--text-muted);\n            transition: transform 0.25s ease;\n        }\n\n        details.bts-theater:not([open]) .toggle-btn {\n            transform: rotate(-90deg);\n        }\n\n        details.bts-theater:not([open]) summary.bts-header {\n            border-bottom: none;\n        }\n\n        /* 整体花絮放映区 */\n        .bts-stage {\n            position: relative;\n            margin: 16px 20px;\n            padding: 22px 24px;\n            background: var(--bg-stage);\n            border-radius: 10px;\n            border: 1px solid rgba(255, 255, 255, 0.04);\n            box-shadow: inset 0 2px 12px rgba(0, 0, 0, 0.35);\n        }\n\n        /* 摄影机取景框四角准星装饰 */\n        .corner {\n            position: absolute;\n            width: 10px;\n            height: 10px;\n            border-color: rgba(245, 158, 11, 0.45);\n            pointer-events: none;\n        }\n        .corner.tl { top: 8px; left: 8px; border-top: 2px solid; border-left: 2px solid; }\n        .corner.tr { top: 8px; right: 8px; border-top: 2px solid; border-right: 2px solid; }\n        .corner.bl { bottom: 8px; left: 8px; border-bottom: 2px solid; border-left: 2px solid; }\n        .corner.br { bottom: 8px; right: 8px; border-bottom: 2px solid; border-right: 2px solid; }\n\n        /* 整体故事排版 */\n        .bts-story {\n            font-size: 14.5px;\n            line-height: 1.85;\n            color: var(--text-body);\n            text-align: justify;\n            letter-spacing: 0.2px;\n        }\n\n        .bts-story p {\n            margin: 0 0 14px 0;\n            text-indent: 2em;\n        }\n\n        .bts-story p:last-child {\n            margin-bottom: 0;\n        }\n\n        .bts-story p.director-cut {\n            text-indent: 0;\n            padding: 8px 14px;\n            margin-bottom: 16px;\n            background: rgba(245, 158, 11, 0.08);\n            border-left: 3px solid var(--gold-accent);\n            border-radius: 0 6px 6px 0;\n            color: #fef3c7;\n            font-weight: 600;\n        }\n\n        .quote-hl {\n            color: var(--text-quote);\n        }\n\n        .bts-footer {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 10px 20px 12px 20px;\n            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n            font-size: 11px;\n            color: #6b7280;\n            border-top: 1px solid rgba(255, 255, 255, 0.03);\n            background: rgba(0, 0, 0, 0.2);\n        }\n\n        @media (max-width: 600px) {\n            body { padding: 6px; }\n            .header-bar { padding: 12px 14px; }\n            .header-sub { display: none; }\n            .bts-stage { margin: 12px 12px; padding: 16px 16px; }\n            .bts-story { font-size: 14px; line-height: 1.75; text-align: left; }\n            .bts-footer { padding: 8px 14px; font-size: 10px; }\n        }\n    </style>\n</head>\n<body>\n\n<!-- 已去掉 open 属性，现在默认处于折叠收起状态 -->\n<details class=\"bts-theater\">\n    <summary class=\"bts-header\">\n        <div class=\"clapper-top\"></div>\n        <div class=\"header-bar\">\n            <div class=\"header-left\">\n                <span class=\"slate-icon\">🎬</span>\n                <span class=\"header-title\">片场拍摄花絮</span>\n                <span class=\"header-sub\">点击展开</span>\n            </div>\n            <div class=\"header-right\">\n                <span class=\"rec-indicator\"><span class=\"rec-dot\"></span>PLAYBACK</span>\n                <span class=\"toggle-btn\">▼</span>\n            </div>\n        </div>\n    </summary>\n\n    <div class=\"bts-stage\">\n        <span class=\"corner tl\"></span>\n        <span class=\"corner tr\"></span>\n        <span class=\"corner bl\"></span>\n        <span class=\"corner br\"></span>\n        <div class=\"bts-story\" id=\"storyContainer\"></div>\n    </div>\n\n    <div class=\"bts-footer\">\n        <span>CAM-A // 24FPS // MONITOR VIEW</span>\n        <span>SCENE WRAP · CUT &amp; PRINT</span>\n    </div>\n</details>\n\n<template id=\"payload1\">$1</template>\n\n<script>\n(function() {\n    'use strict';\n    function escHtml(v){return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');}\n\n    const payload = document.getElementById('payload1');\n    const container = document.getElementById('storyContainer');\n    if (!payload || !container) return;\n\n    const raw = ((payload.content ? payload.content.textContent : payload.textContent) || '').replace(/<\\/?BTS>/gi, '').trim();\n    const paragraphs = raw.split(/\\r?\\n/).map(p => p.trim()).filter(Boolean);\n\n    function highlightDialogue(rawText) {\n        const text = escHtml(rawText);\n        return text.split('“').map((seg, i) => {\n            if (i === 0) return seg;\n            const endIdx = seg.indexOf('”');\n            if (endIdx !== -1) {\n                return '<span class=\"quote-hl\">“' + seg.substring(0, endIdx + 1) + '</span>' + seg.substring(endIdx + 1);\n            }\n            return '“' + seg;\n        }).join('');\n    }\n\n    container.innerHTML = paragraphs.map((para, index) => {\n        const isCutLine = index === 0 && /咔|收工|这条过/.test(para);\n        const cls = isCutLine ? ' class=\"director-cut\"' : '';\n        return '<p' + cls + '>' + highlightDialogue(para) + '</p>';\n    }).join('');\n})();\n</script>\n</body>\n</html>\n```",
            "placement": [
