          {
            "id": "kl-re-status-card-05",
            "scriptName": "昆仑-场景小结与状态美化卡片(显示, 0~1层)",
            "disabled": false,
            "runOnEdit": true,
            "findRegex": "/<sumUp>([\\s\\S]*?)<\\/sumUp>[\\s\\S]*?<pose>([\\s\\S]*?)<\\/pose>/g",
            "trimStrings": [],
            "replaceString": "```\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>高级场景小结面板 - 极速纯享版(响应式+单行排列)</title>\n    <style>\n        :root {\n            --panel-bg: rgba(26, 26, 32, 0.98);\n            --panel-border: rgba(255, 255, 255, 0.08);\n            --text-main: #f3f4f6;\n            --text-sub: #9ca3af;\n            --theme-color: #a855f7; \n            --theme-glow: rgba(168, 85, 247, 0.15);\n            --radius-box: 16px;\n            --radius-item: 10px;\n        }\n\n        body {\n            margin: 0;\n            padding: 24px;\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n            color: var(--text-main);\n            background: transparent; \n            display: flex;\n            justify-content: center;\n        }\n\n        .summary-wrapper {\n            width: 100%;\n            max-width: 760px;\n            margin: 0 auto;\n            background: var(--panel-bg);\n            border: 1px solid var(--panel-border);\n            border-radius: var(--radius-box);\n            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n        }\n\n        .summary-header {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            padding: 16px 20px;\n            border-bottom: 1px solid rgba(255, 255, 255, 0.03);\n            background: rgba(255, 255, 255, 0.02);\n            cursor: pointer;\n            user-select: none;\n            transition: background 0.15s;\n        }\n\n        .summary-header:hover {\n            background: rgba(255, 255, 255, 0.05);\n        }\n\n        .header-title-group {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n            font-size: 15px;\n            font-weight: 600;\n        }\n\n        .header-icon {\n            color: var(--theme-color);\n            font-size: 16px;\n        }\n\n        .meta-badges {\n            display: flex;\n            gap: 8px;\n            flex-wrap: wrap;\n            justify-content: flex-end;\n            pointer-events: none;\n        }\n\n        .meta-pill {\n            display: inline-flex;\n            align-items: center;\n            gap: 4px;\n            background: rgba(0, 0, 0, 0.4);\n            color: #d1d5db;\n            padding: 4px 10px;\n            font-size: 12px;\n            border-radius: 20px;\n            border: 1px solid rgba(255, 255, 255, 0.06);\n        }\n\n        .collapse-viewport.is-folded {\n            display: none;\n        }\n\n        .status-grid {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 10px;\n            padding: 16px 20px 0 20px;\n        }\n\n        .status-grid:empty {\n            display: none;\n            padding: 0;\n        }\n\n        .status-item {\n            background: rgba(255, 255, 255, 0.015);\n            border: 1px solid rgba(255, 255, 255, 0.03);\n            border-radius: 8px;\n            padding: 10px 14px;\n            display: flex;\n            flex-direction: column;\n            gap: 6px;\n            transition: background 0.15s, border-color 0.15s;\n        }\n\n        .status-item:hover {\n            background: rgba(255, 255, 255, 0.04);\n            border-color: rgba(255, 255, 255, 0.08);\n        }\n\n        .status-label {\n            font-size: 12px;\n            color: var(--text-sub);\n            display: flex;\n            align-items: center;\n            gap: 6px;\n            font-weight: 600;\n        }\n\n        .status-value {\n            font-size: 13.5px;\n            color: var(--text-main);\n            line-height: 1.5;\n        }\n\n        .content-stream {\n            display: flex;\n            flex-direction: column;\n            padding: 16px 20px 20px 20px;\n            gap: 10px;\n            margin: 0;\n            list-style: none;\n        }\n\n        .content-stream:empty {\n            display: none;\n            padding: 0;\n        }\n\n        .stream-card {\n            display: flex;\n            align-items: flex-start;\n            gap: 12px;\n            padding: 14px 16px;\n            border-radius: var(--radius-item);\n            background: rgba(255, 255, 255, 0.015);\n            border: 1px solid rgba(255, 255, 255, 0.03);\n            transition: background 0.15s, border-color 0.15s;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .stream-card:hover {\n            background: rgba(255, 255, 255, 0.04);\n            border-color: rgba(168, 85, 247, 0.25);\n        }\n\n        .stream-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 3px;\n            background: var(--theme-color);\n            opacity: 0;\n            transition: opacity 0.15s;\n        }\n\n        .stream-card:hover::before {\n            opacity: 1;\n        }\n\n        .card-tag {\n            background: var(--theme-glow);\n            color: #d8b4fe;\n            font-size: 12px;\n            font-weight: 700;\n            padding: 4px 8px;\n            border-radius: 6px;\n            white-space: nowrap;\n            border: 1px solid rgba(168, 85, 247, 0.2);\n            flex-shrink: 0;\n            margin-top: 2px;\n        }\n\n        .card-desc {\n            font-size: 14px;\n            line-height: 1.6;\n            color: #e5e7eb;\n            word-break: break-word;\n            flex-grow: 1;\n        }\n\n        @media (max-width: 600px) {\n            body {\n                padding: 12px;\n            }\n\n            .summary-header {\n                flex-direction: column;\n                align-items: flex-start;\n                gap: 12px;\n                padding: 14px 16px;\n            }\n\n            .meta-badges {\n                justify-content: flex-start;\n                width: 100%;\n            }\n\n            .status-grid {\n                grid-template-columns: 1fr;\n                gap: 8px;\n                padding: 14px 16px 0 16px;\n            }\n\n            .status-item {\n                padding: 8px 10px;\n                gap: 4px;\n            }\n\n            .status-label {\n                font-size: 11px;\n            }\n\n            .status-value {\n                font-size: 12.5px;\n            }\n\n            .content-stream {\n                padding: 14px 16px 16px 16px;\n                gap: 8px;\n            }\n\n            .stream-card {\n                padding: 12px 14px;\n                gap: 10px;\n                flex-direction: column;\n            }\n\n            .card-tag {\n                margin-top: 0;\n                font-size: 11px;\n                padding: 3px 6px;\n            }\n\n            .card-desc {\n                font-size: 13.5px;\n            }\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"summary-wrapper\">\n    <div class=\"summary-header\" id=\"panelTrigger\">\n        <div class=\"header-title-group\">\n            <span class=\"header-icon\">✧</span>\n            场景概览\n        </div>\n        <div class=\"meta-badges\" id=\"metaContainer\"></div>\n    </div>\n\n    <div class=\"collapse-viewport\" id=\"viewportArea\">\n        <div id=\"statusGrid\" class=\"status-grid\"></div>\n        <ul class=\"content-stream\" id=\"streamList\"></ul>\n    </div>\n</div>\n\n<template id=\"payload1\">$1</template>\n<template id=\"payload2\">$2</template>\n\n<script>\n(function() {\n    'use strict';\n    function escHtml(v){return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');}\n\n    class SceneSummaryModule {\n        constructor() {\n            this.domRefs = {\n                payload1: document.getElementById('payload1'),\n                payload2: document.getElementById('payload2'),\n                metaContainer: document.getElementById('metaContainer'),\n                statusGrid: document.getElementById('statusGrid'),\n                listContainer: document.getElementById('streamList'),\n                triggerHeader: document.getElementById('panelTrigger'),\n                viewport: document.getElementById('viewportArea')\n            };\n            this.init();\n        }\n\n        init() {\n            this.renderContent();\n            this.bindEvents();\n            if (this.domRefs.viewport) {\n                this.domRefs.viewport.classList.add('is-folded');\n            }\n        }\n\n        parseData() {\n            const raw1 = this.domRefs.payload1 ? (this.domRefs.payload1.content ? this.domRefs.payload1.content.textContent : this.domRefs.payload1.textContent) || \"\" : \"\";\n            const raw2 = this.domRefs.payload2 ? (this.domRefs.payload2.content ? this.domRefs.payload2.content.textContent : this.domRefs.payload2.textContent) || \"\" : \"\";\n            const combinedRaw = raw1 + '\\n' + raw2;\n\n            const lines = combinedRaw.split('\\n').map(line => line.trim()).filter(Boolean);\n            \n            const metaItems = [];\n            const attrItems = [];\n            const streamItems = [];\n\n            lines.forEach(line => {\n                const cCN = line.indexOf('：'), cEN = line.indexOf(':'); const colonIndex = (cCN !== -1 && cEN !== -1) ? Math.min(cCN, cEN) : Math.max(cCN, cEN);\n                let tag = '记录';\n                let text = line;\n\n                if (colonIndex > 0 && colonIndex <= 15) {\n                    tag = line.substring(0, colonIndex).trim();\n                    text = line.substring(colonIndex + 1).trim();\n                }\n\n                tag = tag.replace(/[【】\\[\\]]/g, '').trim();\n\n                if (['地点', '时间', '日期', '天气'].includes(tag)) {\n                    metaItems.push({ tag, text });\n                } else if (['人物', '位置', '姿势', '状态'].includes(tag)) {\n                    attrItems.push({ tag, text });\n                } else {\n                    streamItems.push({ tag, text });\n                }\n            });\n\n            return { metaItems, attrItems, streamItems };\n        }\n\n        getIconForTag(tag) {\n            if (tag === '地点' || tag === '位置') return '📍';\n            if (tag === '天气') return '🌦️';\n            if (tag === '时间' || tag === '日期') return '🕰️';\n            if (tag === '人物') return '👥';\n            if (tag === '姿势' || tag === '状态') return '🧍';\n            return '✨';\n        }\n\n        renderContent() {\n            const { metaItems, attrItems, streamItems } = this.parseData();\n\n            if (metaItems.length > 0 && this.domRefs.metaContainer) {\n                this.domRefs.metaContainer.innerHTML = metaItems.map(item => `\n                    <span class=\"meta-pill\">\n                        <i style=\"font-style:normal\">${this.getIconForTag(item.tag)}</i>\n                        ${escHtml(item.text)}\n                    </span>\n                `).join('');\n            }\n\n            if (attrItems.length > 0 && this.domRefs.statusGrid) {\n                this.domRefs.statusGrid.innerHTML = attrItems.map(item => `\n                    <div class=\"status-item\">\n                        <div class=\"status-label\">\n                            <i style=\"font-style:normal\">${this.getIconForTag(item.tag)}</i> ${escHtml(item.tag)}\n                        </div>\n                        <div class=\"status-value\">${escHtml(item.text)}</div>\n                    </div>\n                `).join('');\n            }\n\n            if (streamItems.length > 0 && this.domRefs.listContainer) {\n                this.domRefs.listContainer.innerHTML = streamItems.map(item => `\n                    <li class=\"stream-card\">\n                        <div class=\"card-tag\">${escHtml(item.tag)}</div>\n                        <div class=\"card-desc\">${escHtml(item.text)}</div>\n                    </li>\n                `).join('');\n            }\n        }\n\n        bindEvents() {\n            if (this.domRefs.triggerHeader && this.domRefs.viewport) {\n                this.domRefs.triggerHeader.addEventListener('click', () => {\n                    this.domRefs.viewport.classList.toggle('is-folded');\n                });\n            }\n        }\n    }\n\n    try {\n        new SceneSummaryModule();\n    } catch (e) {\n        console.error(\"面板初始化失败:\", e);\n    }\n})();\n</script>\n</body>\n</html>\n```",
            "placement": [
